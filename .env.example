# Prisma: set PRISMA_LOG_QUERIES=1 to log every SQL query in dev (slower terminal)
# PRISMA_LOG_QUERIES=0

# Database — see docs/SUPABASE.md (Tescommerce: Supabase eu-central-1)
# Supabase — runtime + Vercel (transaction pooler :6543):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Prisma migrations / db:push (same pooler if session :5432 fails):
# DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DATABASE_URL_VERCEL=  # optional; used by npm run vercel:database-url
# Local Docker Postgres (optional):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ugclab?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ugclab?schema=public"
#
# If DATABASE_URL is prisma:// (Accelerate), LOCAL DEV still needs DIRECT_URL=postgres://...
# (prisma generate uses DIRECT_URL so the query engine is included — see packages/database/scripts/generate-client.mjs)
# CRON_SECRET="openssl-rand-for-warm-cron"

# Auth (shared across apps)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3001"
# Google OAuth for merchant login (optional)
# Create OAuth client: Google Cloud Console → APIs → Credentials → OAuth 2.0
# Authorized redirect URI: {API_PUBLIC_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# API_PUBLIC_URL="http://localhost:4000"

# App URLs (local dev)
PLATFORM_URL="http://localhost:3000"
NEXT_PUBLIC_PLATFORM_URL="http://localhost:3000"
MERCHANT_ADMIN_URL="http://localhost:3001"
PLATFORM_ADMIN_URL="http://localhost:3003"
API_PORT=4000
STOREFRONT_URL="http://localhost:3002"
STOREFRONT_BASE_DOMAIN="localhost:3002"
# Subdomain stores: slug.STORE_BASE_DOMAIN (production)
STORE_BASE_DOMAIN="ugclab.store"
# Merchant Vite admin also reads STOREFRONT_* from repo root (optional alias):
# VITE_STOREFRONT_URL="http://localhost:3002"

# Payment model: mor (platform collects all, pays merchants) | connect (Stripe per merchant)
PAYMENT_MODEL=mor
# MoR payout rules (merchant requests + platform admin)
MOR_MIN_PAYOUT_CENTS=5000
MOR_PAYOUT_SCHEDULE=Weekly payouts (manual processing)
# Optional: WISE_API_KEY= for future auto-payouts via Wise

# Stripe — MoR: one platform account for all store checkouts (no Connect)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Local: stripe listen --forward-to localhost:4000/api/stripe/webhook
# Prod: Dashboard → Webhooks → POST https://your-api/api/stripe/webhook
# Events: checkout.session.completed, charge.refunded, customer.subscription.*
# Optional: Stripe Price ID for Pro plan (else price_data is used at checkout)
STRIPE_PRICE_PRO=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# GoPay KG — local checkout when store currency is KGS (https://doc.gopay.kg/v1/)
# Keys: merchant.gopay.kg → Developer → API Keys; Webhooks → events_url → https://your-api/api/gopay/webhook
GOPAY_API_KEY=""
GOPAY_SECRET_KEY=""
GOPAY_WEBHOOK_SECRET=""
# GOPAY_API_BASE="https://api.gopay.kg"
# API_PUBLIC_URL="http://localhost:4000"
# GOPAY_TESTING_MODE=1

# Finik KG — QR checkout when currency is KGS (priority over GoPay if both set)
# Docs: https://www.finik.kg/documentation/web-sdk/integration/ — see docs/FINIK-KG.md
# FINIK_API_KEY=""
# FINIK_ACCOUNT_ID=""
# FINIK_PRIVATE_PEM=""
# FINIK_WEBHOOK_PUBLIC_PEM=""
# FINIK_QR_NAME="Tescommerce"
# FINIK_BETA=1
# FINIK_API_BASE="https://api.acquiring.averspay.kg"

# Shippo — auto shipping labels (merchant order detail → Shippo label)
SHIPPO_API_KEY=""

# Email (Resend — https://resend.com/api-keys; domain must be verified)
RESEND_API_KEY=""
# SENDGRID_API_KEY=""
EMAIL_FROM="Tescommerce <info@tescommerce.com>"
# Landing signup link in outreach emails
PLATFORM_URL="https://tescommerce.com"
PLATFORM_BRAND_NAME="Tescommerce"
# Optional logo in outreach emails (PNG, ~200×48px)
# OUTREACH_LOGO_URL="https://tescommerce.com/your-logo.png"
# Outreach: Importance / X-Priority headers (default on). Set false to disable.
# OUTREACH_HIGH_PRIORITY=true
# MoR payout request alerts to platform ops (optional)
# PLATFORM_OPS_EMAIL="ops@yourcompany.com"

# Marketing (open/click tracking, unsubscribe links)
API_PUBLIC_URL="http://localhost:4000"
MARKETING_DAILY_CAP_PER_TENANT=2000

# Defaults
DEFAULT_LOCALE="en"
APP_REGION="us"

# Custom domains — storefront routing (Vercel + DNS)
STOREFRONT_CNAME_TARGET="cname.tescommerce.com"
# VERCEL_TOKEN=
# VERCEL_STOREFRONT_PROJECT_ID=
# VERCEL_TEAM_ID=

# Optional: Entri Sell Enterprise — live domain search + future in-app registration
# https://www.entri.com/ — POST https://api.goentri.com/token
# ENTRI_APPLICATION_ID=
# ENTRI_CLIENT_SECRET=