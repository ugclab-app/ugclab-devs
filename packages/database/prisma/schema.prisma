generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MERCHANT
  SUPER_ADMIN
  PLATFORM_OPS
  PLATFORM_SUPPORT
  PLATFORM_FINANCE
}

enum UserAccountStatus {
  ACTIVE
  BANNED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum ProductType {
  PHYSICAL
  DIGITAL
  SERVICE
}

enum CollectionRuleType {
  MANUAL
  AUTO_TAG
  AUTO_TYPE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum InventoryTransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  DECLINED
  LABEL_CREATED
  IN_TRANSIT
  RECEIVED
  REFUNDED
  EXCHANGED
  CANCELLED
}

enum MetafieldOwnerType {
  PRODUCT
  VARIANT
  CUSTOMER
  ORDER
  SHOP
  METAOBJECT
}

enum B2bCompanyStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum B2bBuyerRole {
  ADMIN
  BUYER
}

enum ProductSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
  INCOMPLETE
}

enum TenantMemberRole {
  OWNER
  ADMIN
  STAFF
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PromotionType {
  CART_PERCENT
  FREE_SHIPPING
}

enum AffiliatePartnerStatus {
  ACTIVE
  PAUSED
}

enum AffiliateCommissionStatus {
  APPROVED
  PAID
  VOID
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  avatarUrl    String?
  country      String?  @db.Char(2)
  timezone     String   @default("UTC")
  role              UserRole          @default(MERCHANT)
  accountStatus     UserAccountStatus @default(ACTIVE)
  bannedAt          DateTime?         @db.Timestamptz(6)
  lastLoginAt       DateTime?         @db.Timestamptz(6)
  sessionVersion    Int               @default(0)
  requireAdmin2fa   Boolean           @default(false)
  totpSecret        String?
  totpEnabled       Boolean           @default(false)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)

  tenants       Tenant[]
  tenantMembers TenantMember[]
  platformPartner PlatformPartner?
  accounts      Account[]
  sessions      Session[]
  knownDevices  UserKnownDevice[]
}

model UserKnownDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String
  userAgent   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([userId, fingerprint])
  @@index([userId])
}

model OutreachProspect {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  templateKey  String    @default("outreach_welcome")
  status       String    @default("PENDING")
  sentAt       DateTime? @db.Timestamptz(6)
  registeredAt DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt])
}

model PlatformAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String
  actorEmail   String
  action       String
  targetUserId String?
  summary      String
  meta         Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
  @@index([targetUserId])
}

model PlatformInstagramPost {
  id        String   @id @default(cuid())
  title     String
  caption   String   @db.Text
  hashtags  String   @default("") @db.Text
  imageUrl  String?
  format    String   @default("square")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([updatedAt])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

enum PlatformPartnerStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum PlatformReferralKind {
  BOUNTY
  FEE_SHARE
}

enum PlatformReferralStatus {
  PENDING
  AVAILABLE
  PAID
  VOID
}

enum PlatformPartnerPayoutStatus {
  PENDING
  PROCESSING
  PAID
}

model PlatformPartnerProgram {
  id              String   @id @default("default")
  bountyCents     Int      @default(0)
  /// Basis points of paid order total. 20 = 0.2%.
  feeShareBps     Int      @default(20)
  shareMonths     Int      @default(12)
  cookieDays      Int      @default(90)
  holdDays        Int      @default(14)
  minPayoutCents  Int      @default(5000)
  tierStores      Int      @default(5)
  tierFeeShareBps Int      @default(3000)
  promoTrialDays  Int      @default(30)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
}

model PlatformPartner {
  id            String                @id @default(cuid())
  email         String                @unique
  name          String
  pitch         String                @db.Text
  code          String                @unique
  status        PlatformPartnerStatus @default(PENDING)
  userId        String?               @unique
  payoutMethod  String?
  payoutDetails String?               @db.Text
  feeShareBps   Int?
  bountyCents   Int?
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(6)

  user       User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  clicks     PlatformPartnerClick[]
  referrals  PlatformPartnerReferral[]
  stores     Tenant[]
  payouts    PlatformPartnerPayout[]
}

model PlatformPartnerClick {
  id        String   @id @default(cuid())
  partnerId String
  source    String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  partner PlatformPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
}

model PlatformPartnerReferral {
  id           String                 @id @default(cuid())
  partnerId    String
  tenantId     String
  orderId      String?
  kind         PlatformReferralKind
  periodKey    String
  amountCents  Int
  currency     String                 @db.Char(3)
  status       PlatformReferralStatus @default(PENDING)
  availableAt  DateTime               @db.Timestamptz(6)
  payoutId     String?
  createdAt    DateTime               @default(now()) @db.Timestamptz(6)

  partner PlatformPartner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  tenant  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payout  PlatformPartnerPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@unique([tenantId, kind, periodKey])
  @@index([partnerId, status])
  @@index([status, availableAt])
}

model PlatformPartnerPayout {
  id          String                      @id @default(cuid())
  partnerId   String
  amountCents Int
  currency    String                      @db.Char(3)
  status      PlatformPartnerPayoutStatus @default(PENDING)
  note        String?                     @db.Text
  paidAt      DateTime?                   @db.Timestamptz(6)
  createdAt   DateTime                    @default(now()) @db.Timestamptz(6)

  partner    PlatformPartner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referrals  PlatformPartnerReferral[]

  @@index([partnerId, status])
}

model PlatformNote {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  body        String   @db.Text
  actorUserId String
  actorEmail  String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([entityType, entityId])
}

model PlatformAnnouncement {
  id        String   @id @default(cuid())
  active    Boolean  @default(false)
  title     String
  message   String   @db.Text
  planSlugs String[] @default([])
  tenantIds String[] @default([])
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

/** Direct message from platform ops to a single merchant (visible in merchant admin). */
model PlatformMerchantMessage {
  id                String    @id @default(cuid())
  tenantId          String
  subject           String
  body              String    @db.Text
  actorUserId       String
  actorEmail        String
  notifyEmail       Boolean   @default(true)
  readAt            DateTime? @db.Timestamptz(6)
  merchantReply     String?   @db.Text
  merchantRepliedAt DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, readAt])
}

model PlatformEmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  subject   String
  html      String   @db.Text
  text      String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model StoreBlockCatalog {
  id          String  @id
  label       String
  description String? @db.Text
  category    String
  published   Boolean @default(true)
  sortOrder   Int     @default(0)
  minPlan     String?
  deprecated  Boolean @default(false)
}

model StoreSectionCatalog {
  id          String  @id
  label       String
  description String? @db.Text
  category    String
  published   Boolean @default(true)
  sortOrder   Int     @default(0)
  blocksJson  Json?
  deprecated  Boolean @default(false)
}

model PlatformEmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String?
  status    String   @default("sent")
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
}

/** One conversation in the platform mailbox (support@ / EMAIL_FROM). */
model PlatformMailboxThread {
  id                 String   @id @default(cuid())
  subject            String
  correspondentEmail String
  correspondentName  String?
  /// open, waiting, or closed
  status             String   @default("open")
  unread             Boolean  @default(false)
  lastMessageAt      DateTime @default(now()) @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  messages PlatformMailboxMessage[]
  notes    PlatformMailboxNote[]

  @@index([lastMessageAt])
  @@index([correspondentEmail])
  @@index([unread])
  @@index([status, lastMessageAt])
}

/** Who on the platform team owns an inbox action item. */
model PlatformInboxAssignment {
  itemId          String   @id
  assigneeUserId  String
  assigneeEmail   String
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
}

model PlatformMailboxNote {
  id          String   @id @default(cuid())
  threadId    String
  body        String   @db.Text
  actorUserId String
  actorEmail  String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  thread PlatformMailboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model PlatformMailboxMessage {
  id            String   @id @default(cuid())
  threadId      String
  direction     String
  fromEmail     String
  toEmail       String
  subject       String
  textBody      String   @db.Text
  htmlBody      String?  @db.Text
  attachments   String?
  /// [{ id, filename, contentType, size }] for Resend receiving downloads
  attachmentMeta Json?
  resendEmailId String?  @unique
  rfcMessageId  String?  @unique
  actorUserId   String?
  actorEmail    String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  thread PlatformMailboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model StoreThemeCatalog {
  id          String  @id
  label       String
  published   Boolean @default(true)
  featured    Boolean @default(false)
  sortOrder   Int     @default(0)
  category    String?
  description String? @db.Text
  previewUrl  String?
  minPlan     String?
  deprecated  Boolean @default(false)
  priceCents  Int     @default(0)
}

model PlatformApp {
  id          String  @id
  name        String
  summary     String
  description String  @db.Text
  category    String
  priceCents  Int     @default(0)
  interval    String  @default("once")
  published   Boolean @default(true)
  sortOrder   Int     @default(0)
}

model TenantAddon {
  id                   String    @id @default(cuid())
  tenantId             String
  kind                 String
  itemId               String
  priceCents           Int
  interval             String    @default("once")
  status               String    @default("active")
  stripeSessionId      String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime? @db.Timestamptz(6)
  config               Json?
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, itemId])
  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
}

model SubscriptionPlan {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  priceMonthly    Int
  currency        String   @default("USD") @db.Char(3)
  productLimit    Int?
  platformFeeBps  Int      @default(500)
  stripePriceId   String?
  trialDays       Int      @default(14)
  features        Json?
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  tenants Tenant[]
}

model PlatformBlacklistEntry {
  id        String   @id @default(cuid())
  type      String
  value     String   @unique
  reason    String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([type])
}

model Tenant {
  id                 String       @id @default(cuid())
  slug               String       @unique
  name               String
  status             TenantStatus @default(ACTIVE)
  ownerId            String
  subscriptionPlanId       String?
  stripeBillingCustomerId  String?   @unique
  stripeSubscriptionId     String?   @unique
  subscriptionStatus       String?
  trialEndsAt              DateTime? @db.Timestamptz(6)
  stripeAccountId          String?   @unique
  stripeChargesEnabled     Boolean   @default(false)
  stripeDetailsSubmitted   Boolean   @default(false)
  platformFeeBpsOverride   Int?
  platformCreditCents      Int       @default(0)
  featureFlags             Json?
  platformFlags            String[]     @default([])
  platformPartnerId        String?
  /// Fee-share rate locked when the store was referred.
  platformPartnerFeeBps    Int?
  /// outreach, partner, or direct. Empty on stores opened before this field.
  acquisitionSource        String?
  activationNudgeSentAt    DateTime? @db.Timestamptz(6)
  /// Past-due billing reminder step (0 = none, 1/2/3 = day 0/3/7 emails).
  dunningStep              Int       @default(0)
  lastDunningAt            DateTime? @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(6)

  owner            User              @relation(fields: [ownerId], references: [id])
  platformPartner  PlatformPartner?  @relation(fields: [platformPartnerId], references: [id], onDelete: SetNull)
  subscriptionPlan SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  settings         StoreSettings?
  products         Product[]
  collections      Collection[]
  orders           Order[]
  customers        Customer[]
  customDomains    CustomDomain[]
  shippingZones    ShippingZone[]
  members          TenantMember[]
  discountCodes    DiscountCode[]
  storePages       StorePage[]
  productReviews   ProductReview[]
  productQuestions ProductQuestion[]
  promotions       StorePromotion[]
  abandonedCarts   AbandonedCart[]
  liveVisitors     StoreLiveVisitor[]
  activityLogs     ActivityLog[]
  emailCampaigns   EmailCampaign[]
  emailAutomations EmailAutomation[]
  emailSubscribers EmailSubscriber[]
  merchantPayouts  MerchantPayout[]
  giftCards        GiftCard[]
  productBundles   ProductBundle[]
  warehouses       Warehouse[]
  merchantWebhooks MerchantWebhook[]
  merchantWebhookDeliveries MerchantWebhookDelivery[]
  merchantApiKeys  MerchantApiKey[]
  inventoryTransfers InventoryTransfer[]
  purchaseOrders     PurchaseOrder[]
  inventoryMovements InventoryMovement[]
  affiliateProgramSettings AffiliateProgramSettings?
  affiliatePartners        AffiliatePartner[]
  affiliateCommissions     AffiliateCommission[]
  platformReferrals        PlatformPartnerReferral[]
  platformMessages         PlatformMerchantMessage[]
  metaobjectDefinitions    MetaobjectDefinition[]
  metaobjects              Metaobject[]
  metafields               Metafield[]
  returnRequests           ReturnRequest[]
  b2bCompanies             B2bCompany[]
  b2bPriceLists            B2bPriceList[]
  productSubscriptions     ProductSubscription[]
  fulfillmentShipments     FulfillmentShipment[]
  b2bQuotes                B2bQuote[]
  digitalEntitlements      DigitalEntitlement[]
  addons                   TenantAddon[]
  merchantKyc              MerchantKyc?
  supplierAccounts         SupplierAccount[]
  planCancelFeedbacks      PlanCancelFeedback[]
  savedFilters             SavedFilter[]
}

enum SupplierProvider {
  CJ
  PRINTFUL
  PRINTIFY
}

/// Merchant's own supplier account. The platform does not pay the supplier.
model SupplierAccount {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider       SupplierProvider
  apiKey         String
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  externalShopId String?
  /// Selling price = supplier cost × (1 + markupPercent/100). Empty means no rule.
  markupPercent  Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  links          SupplierProductLink[]
  orders         SupplierOrder[]

  @@unique([tenantId, provider])
  @@index([tenantId])
}

model SupplierProductLink {
  id                String          @id @default(cuid())
  tenantId          String
  productId         String          @unique
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  accountId         String
  account           SupplierAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalProductId String
  externalVariantId String
  externalSku       String?
  costCents         Int?
  costCurrency      String          @default("USD")
  createdAt         DateTime        @default(now())

  @@index([tenantId])
  @@index([accountId])
}

model SupplierOrder {
  id              String          @id @default(cuid())
  tenantId        String
  orderId         String
  accountId       String
  account         SupplierAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  provider        SupplierProvider
  externalOrderId String?
  status          String
  error           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([orderId, accountId])
  @@index([tenantId, status])
}

enum MerchantKycStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Passport check reviewed by platform staff. Finik has no passport API.
model MerchantKyc {
  id               String            @id @default(cuid())
  tenantId         String            @unique
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status           MerchantKycStatus @default(PENDING)
  legalName        String
  country          String            @db.Char(2)
  passportNumber   String
  passportFile     String
  selfieFile       String?
  rejectReason     String?
  reviewedByEmail  String?
  reviewedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, createdAt])
}

model MerchantPayout {
  id        String   @id @default(cuid())
  tenantId  String
  amount    Int
  currency  String   @default("USD") @db.Char(3)
  status    String   @default("PENDING")
  note      String?  @db.Text
  paidAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model AffiliateProgramSettings {
  tenantId             String   @id
  enabled              Boolean  @default(false)
  defaultCommissionBps Int      @default(1000)
  cookieDays           Int      @default(30)
  attributionModel     String   @default("last_click")
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AffiliatePartner {
  id            String                 @id @default(cuid())
  tenantId      String
  code          String
  displayName   String
  email         String?
  commissionBps Int?
  status        AffiliatePartnerStatus @default(ACTIVE)
  note          String?                @db.Text
  createdAt     DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @db.Timestamptz(6)

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders       Order[]
  commissions  AffiliateCommission[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model AffiliateCommission {
  id               String                    @id @default(cuid())
  tenantId         String
  partnerId        String
  orderId          String                    @unique
  orderTotalCents  Int
  merchantNetCents Int
  commissionBps    Int
  commissionCents  Int
  status           AffiliateCommissionStatus @default(APPROVED)
  paidAt           DateTime?                 @db.Timestamptz(6)
  payoutNote       String?                   @db.Text
  createdAt        DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(6)

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  order   Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([partnerId, status])
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum EmailCampaignSegment {
  ALL
  VIP
  REPEAT
  NEW
  ACTIVE
  ABANDONED_CART
  INACTIVE_90
  COLLECTION
  PRODUCT
  RECENT_30
  RFM_CHAMPIONS
}

enum EmailAutomationType {
  WELCOME
  POST_PURCHASE
  WINBACK
  CUSTOM
}

model StoreSettings {
  tenantId        String   @id
  defaultLocale   String   @default("en")
  enabledLocales  String[] @default(["en"])
  currency        String   @default("USD") @db.Char(3)
  timezone        String   @default("UTC")
  logoUrl         String?
  faviconUrl      String?
  contactEmail    String?
  contactPhone    String?
  businessAddress String?  @db.Text
  emailFromName   String?
  emailReplyTo    String?
  emailDoubleOptIn Boolean @default(false)
  primaryColor    String   @default("#18181b")
  theme           Json?
  privacyUrl      String?
  refundUrl       String?
  privacyPolicy   String?  @db.Text
  refundPolicy    String?  @db.Text
  termsOfService  String?  @db.Text
  termsUrl        String?
  shippingPolicy  String?  @db.Text
  shippingUrl     String?
  legalNotice     String?  @db.Text
  legalNoticeUrl  String?
  contactPolicy   String?  @db.Text
  returnRules     String?  @db.Text
  digitalLinkDays Int      @default(30)
  notifyNewOrders     Boolean  @default(true)
  notifyLowStock      Boolean  @default(true)
  abandonedCartEnabled Boolean @default(true)
  lowStockLastNotifiedAt DateTime? @db.Timestamptz(6)
  taxRateBps      Int      @default(0)
  taxIncluded     Boolean  @default(false)
  seoTitle        String?
  seoDescription  String?  @db.Text
  seoOgImageUrl   String?
  lowStockThreshold   Int      @default(5)
  checkoutGuestLookup Boolean  @default(true)
  checkoutFooterText  String?  @db.Text
  storeAliases        String[] @default([])
  emailOrderSubject   String?
  emailOrderBody      String?  @db.Text
  /// Per-template subject/html overrides. Blank fields use built-in copy.
  emailTemplates      Json?
  /// bcrypt hash. Empty means the storefront is public.
  storefrontPasswordHash String?
  /// Card is reserved until shipment; MoR payout waits for delivery or the protection window.
  buyerProtectionEnabled Boolean @default(false)
  /// Resend sending domain: { domain, resendId, status, fromAddress, records }
  emailDomain         Json?
  themeDraft          Json?
  payoutCurrency      String?  @db.Char(3)
  taxFormType         String?
  taxFormLegalName    String?
  taxFormId           String?
  notifyPayoutFailed  Boolean  @default(true)
  integrations        Json?
  postCheckoutUpsell  Json?
  stripeTaxEnabled    Boolean  @default(false)
  /// Locale code → display currency for catalog FX (e.g. { "ru": "KGS" })
  localeCurrencies    Json?
  /// Markets: country groups with optional tax override
  markets             Json?
  loyaltyEnabled           Boolean @default(false)
  /// Points earned per 1.00 of paid order total (major units).
  loyaltyEarnPerMajor      Int     @default(1)
  /// How many cents one redeemed point is worth at checkout.
  loyaltyRedeemCentsPerPoint Int   @default(1)
  /// ISO-2 countries that cannot check out.
  blockedCountries    String[] @default([])
  tipsEnabled         Boolean  @default(false)
  /// Tip presets in percent of subtotal.
  tipPresets          Int[]    @default([5, 10, 15])
  /// Custom checkout fields: [{ key, label, type: "text"|"date"|"textarea", required }]
  checkoutFields      Json?
  /// Buy now, pay later via Stripe (Klarna / Afterpay / Affirm when currency allows).
  bnplEnabled         Boolean  @default(false)
  /// Sequential invoice numbering, e.g. "INV-" + 000123. Empty prefix = order number is used.
  invoicePrefix       String?
  invoiceNextNumber   Int      @default(1)
  /// Cloudflare Turnstile site key shown on storefront checkout / account forms.
  turnstileSiteKey    String?
  turnstileSecretKey  String?
  /// FX display rounding: { mode: "round"|"floor"|"ceil"|"nearest", step?: number }
  fxRounding          Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantMember {
  id          String           @id @default(cuid())
  tenantId    String
  userId      String?
  email       String
  role        TenantMemberRole @default(STAFF)
  permissions String[]         @default([])
  inviteToken      String?          @unique
  inviteExpiresAt  DateTime?        @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  acceptedAt       DateTime?        @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([userId])
}

model CustomDomain {
  id                String    @id @default(cuid())
  tenantId          String
  domain            String    @unique
  verified          Boolean   @default(false)
  verificationToken String    @default(cuid())
  isPrimary         Boolean   @default(false)
  verifiedAt        DateTime? @db.Timestamptz(6)
  verifiedByEmail   String?
  lastDnsCheckAt    DateTime? @db.Timestamptz(6)
  lastDnsOk         Boolean?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([verified])
}

model StorePromotion {
  id             String        @id @default(cuid())
  tenantId       String
  type           PromotionType
  active         Boolean       @default(true)
  value          Int           @default(0)
  minOrderAmount Int?
  startsAt       DateTime? @db.Timestamptz(6)
  endsAt         DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

model DiscountCode {
  id             String       @id @default(cuid())
  tenantId       String
  code           String
  type           DiscountType
  value          Int
  minOrderAmount Int?
  maxUses        Int?
  usedCount      Int          @default(0)
  active         Boolean      @default(true)
  startsAt       DateTime?    @db.Timestamptz(6)
  expiresAt      DateTime?    @db.Timestamptz(6)
  collectionId   String?
  /// Groups codes created together via batch generate.
  batchId        String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  orders     Order[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, batchId])
}

model DigitalDownload {
  id         String   @id @default(cuid())
  tenantId   String
  orderId    String
  productId  String
  token      String   @unique
  /// License / serial key assigned from the product pool at fulfill time.
  licenseKey String?
  downloads  Int      @default(0)
  expiresAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tenantId])
}

model Product {
  id          String        @id @default(cuid())
  tenantId    String
  type        ProductType
  status      ProductStatus @default(DRAFT)
  title       String
  slug        String
  description String?       @db.Text
  priceAmount Int
  currency    String        @db.Char(3)
  compareAt    Int?
  inventory    Int?
  weightGrams  Int?
  requiresShipping Boolean @default(true)
  hsCode       String?
  countryOfOrigin String?  @db.Char(2)
  sku          String?
  barcode      String?
  tags         String[]      @default([])
  translations Json?
  publishAt    DateTime?     @db.Timestamptz(6)
  costAmountCents Int?
  subscriptionEnabled  Boolean @default(false)
  subscriptionInterval String?
  preorderEnabled         Boolean   @default(false)
  preorderShipAt          DateTime? @db.Timestamptz(6)
  tryBeforeYouBuyEnabled  Boolean   @default(false)
  tryBeforeYouBuyDays     Int?      @default(30)
  sellAsGiftCard          Boolean   @default(false)
  /// Bundle offers: [{ qty, label, priceCents }]
  quantityOffers          Json?
  /// Buyer chooses the price (>= minPriceAmount, or priceAmount when null).
  payWhatYouWant          Boolean   @default(false)
  minPriceAmount          Int?
  /// Soft-delete: hidden from catalog; purge after 30 days.
  deletedAt               DateTime? @db.Timestamptz(6)
  /// Purchase quantity limits (storefront cart / checkout).
  minQuantity             Int       @default(1)
  maxQuantity             Int?
  /// Scheduled price change (applied by cron when scheduledPriceAt <= now).
  scheduledPriceAmount    Int?
  scheduledCompareAt      Int?
  scheduledPriceAt        DateTime? @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants     ProductVariant[]
  bundleItems  ProductBundleItem[]
  warehouseStock WarehouseStock[]
  inventoryMovements InventoryMovement[]
  transferLines      InventoryTransferLine[]
  purchaseOrderLines PurchaseOrderLine[]
  images       ProductImage[]
  digitalAsset DigitalAsset?
  orderItems        OrderLineItem[]
  collectionItems   CollectionProduct[]
  digitalDownloads  DigitalDownload[]
  reviews           ProductReview[]
  questions         ProductQuestion[]
  productSubscriptions ProductSubscription[]
  b2bPriceListItems    B2bPriceListItem[]
  wishlistItems        WishlistItem[]
  stockAlerts          StockAlert[]
  supplierLink         SupplierProductLink?
  revisions            ProductRevision[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([scheduledPriceAt])
}

model ProductVariant {
  id          String @id @default(cuid())
  tenantId    String
  productId   String
  title       String
  sku         String?
  priceAmount Int
  inventory   Int?
  weightGrams Int?
  supplierVariantId String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
}

model ProductImage {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String
  storageKey String
  fileName   String
  mimeType   String   @default("image/jpeg")
  sortOrder  Int      @default(0)
  alt        String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
}

model DigitalAsset {
  id            String @id @default(cuid())
  tenantId      String
  productId     String @unique
  storageKey    String
  fileName      String
  mimeType      String
  sizeBytes     Int
  downloadLimit Int    @default(5)
  /// One unused license key per line; consumed on digital fulfill.
  licenseKeysPool String? @db.Text
  /// Gated course content: [{ title, body, videoUrl }] shown to buyers in their library.
  lessons         Json?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Collection {
  id              String             @id @default(cuid())
  tenantId        String
  title           String
  slug            String
  description     String?            @db.Text
  ruleType        CollectionRuleType @default(MANUAL)
  ruleTag         String?
  ruleProductType ProductType?
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  CollectionProduct[]
  discounts DiscountCode[]

  @@unique([tenantId, slug])
}

model StorePage {
  id              String    @id @default(cuid())
  tenantId        String
  title           String
  slug            String
  body            String    @db.Text
  excerpt         String?   @db.Text
  featuredImageUrl String?
  pageType        String    @default("PAGE")
  published       Boolean   @default(true)
  publishAt       DateTime? @db.Timestamptz(6)
  authorName      String?
  tags            String[]  @default([])
  metaTitle       String?
  metaDescription String?   @db.Text
  ogImageUrl      String?
  canonicalUrl    String?
  noindex         Boolean   @default(false)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, pageType])
  @@index([tenantId, published, publishAt])
}

model ProductReview {
  id               String    @id @default(cuid())
  tenantId         String
  productId        String
  orderId          String?
  authorName       String
  authorEmail      String?
  rating           Int
  body             String?   @db.Text
  photoUrls        String[]  @default([])
  approved         Boolean   @default(false)
  verifiedPurchase Boolean   @default(false)
  pinned           Boolean   @default(false)
  helpfulCount     Int       @default(0)
  merchantReply    String?   @db.Text
  merchantRepliedAt DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([productId, approved])
  @@index([productId, pinned])
  @@index([orderId])
}

model ProductQuestion {
  id          String    @id @default(cuid())
  tenantId    String
  productId   String
  authorName  String
  authorEmail String?
  question    String    @db.Text
  answer      String?   @db.Text
  approved    Boolean   @default(true)
  answeredAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId, approved])
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model Customer {
  id               String   @id @default(cuid())
  tenantId         String
  email            String
  name             String?
  country          String?  @db.Char(2)
  passwordHash     String?
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime? @db.Timestamptz(6)
  marketingOptOut  Boolean  @default(false)
  emailBounced     Boolean  @default(false)
  stripeCustomerId String?
  b2bCompanyId     String?
  loyaltyPoints    Int      @default(0)
  /// Store credit balance (cents, store base currency). Refunds can land here.
  storeCreditCents Int      @default(0)
  /// Set when personal data was erased on a GDPR request; orders stay for accounting.
  anonymizedAt     DateTime? @db.Timestamptz(6)
  /// After merge, source customer points here (kept for audit; email mangled).
  mergedIntoId     String?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  b2bCompany B2bCompany? @relation(fields: [b2bCompanyId], references: [id], onDelete: SetNull)
  b2bBuyer   B2bBuyer?
  orders     Order[]
  returnRequests ReturnRequest[]
  productSubscriptions ProductSubscription[]
  addresses    CustomerAddress[]
  wishlistItems WishlistItem[]
  notes        CustomerNote[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([b2bCompanyId])
  @@index([mergedIntoId])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  label      String?
  name       String
  phone      String?
  address1   String
  address2   String?
  city       String
  postal     String?
  country    String   @db.Char(2)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  productId  String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([tenantId])
}

model StockAlert {
  id          String    @id @default(cuid())
  tenantId    String
  productId   String
  email       String
  /// Empty string when the alert is for the product, otherwise the variant id.
  variantKey  String    @default("")
  notifiedAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, email, variantKey])
  @@index([tenantId, notifiedAt])
}

model Order {
  id              String      @id @default(cuid())
  tenantId        String
  customerId      String?
  orderNumber     String
  status          OrderStatus @default(PENDING)
  currency        String      @db.Char(3)
  subtotalAmount  Int
  shippingAmount  Int         @default(0)
  taxAmount       Int         @default(0)
  totalAmount            Int
  platformFeeAmount      Int         @default(0)
  paymentProvider         String?
  stripePaymentId        String?
  stripeCheckoutSessionId String?    @unique
  gopayPaymentId         String?     @unique
  gopayOrderId           String?     @unique
  finikPaymentId         String?     @unique
  finikTransactionId     String?
  shippingCountry        String?     @db.Char(2)
  shippingName    String?
  shippingAddress1 String?
  shippingAddress2 String?
  shippingCity    String?
  shippingRegion  String?
  shippingPostal  String?
  shippingPhone   String?
  trackingNumber  String?
  shippedAt       DateTime?   @db.Timestamptz(6)
  discountCodeId  String?
  discountAmount  Int         @default(0)
  giftCardId      String?
  giftCardAmount  Int         @default(0)
  loyaltyPointsSpent    Int   @default(0)
  loyaltyDiscountAmount Int   @default(0)
  storeCreditAmount     Int   @default(0)
  tipAmount             Int   @default(0)
  /// Answers to merchant-defined checkout fields: { key: value }
  customFields          Json?
  /// Sequential accounting number assigned when the order is paid (see StoreSettings.invoicePrefix).
  invoiceNumber         String?
  tags            String[]    @default([])
  accessToken     String?     @unique
  guestEmail      String?
  affiliatePartnerId       String?
  affiliateCommissionCents Int         @default(0)
  utmSource                String?
  utmMedium                String?
  utmCampaign              String?
  landingPath              String?
  fulfillmentMethod        String      @default("SHIP")
  pickupWarehouseId        String?
  pickupReadyAt            DateTime?   @db.Timestamptz(6)
  stripeSubscriptionId     String?
  b2bCompanyId             String?
  riskScore                Int?
  riskLevel                String?
  paymentHold              Boolean     @default(false)
  captureMethod            String      @default("automatic")
  paymentCaptureStatus     String      @default("NONE")
  authorizedAt             DateTime?   @db.Timestamptz(6)
  capturedAt               DateTime?   @db.Timestamptz(6)
  buyerProtection          Boolean     @default(false)
  buyerReceivedAt          DateTime?   @db.Timestamptz(6)
  deliveredAt              DateTime?   @db.Timestamptz(6)
  fundsReleasedAt          DateTime?   @db.Timestamptz(6)
  payoutBlocked            Boolean     @default(false)
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(6)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer?       @relation(fields: [customerId], references: [id])
  discountCode DiscountCode?   @relation(fields: [discountCodeId], references: [id])
  giftCard     GiftCard?       @relation(fields: [giftCardId], references: [id])
  affiliatePartner   AffiliatePartner?   @relation(fields: [affiliatePartnerId], references: [id], onDelete: SetNull)
  affiliateCommission AffiliateCommission?
  pickupWarehouse  Warehouse?  @relation("OrderPickupWarehouse", fields: [pickupWarehouseId], references: [id], onDelete: SetNull)
  b2bCompany       B2bCompany? @relation(fields: [b2bCompanyId], references: [id], onDelete: SetNull)
  items            OrderLineItem[]
  events           OrderEvent[]
  digitalDownloads DigitalDownload[]
  returnRequests   ReturnRequest[]
  productSubscriptions ProductSubscription[]
  fulfillmentShipments FulfillmentShipment[]
  productReviews       ProductReview[]

  @@index([affiliatePartnerId])
  @@index([pickupWarehouseId])
  @@index([b2bCompanyId])

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, invoiceNumber])
}

model OrderLineItem {
  id                 String @id @default(cuid())
  tenantId           String
  orderId            String
  productId          String?
  variantId          String?
  title              String
  quantity           Int
  fulfilledQuantity  Int    @default(0)
  unitAmount         Int
  totalAmount        Int
  warehouseId        String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  returnItems ReturnLineItem[]
  fulfillmentLines FulfillmentLine[]

  @@index([tenantId])
  @@index([orderId])
  @@index([warehouseId])
}

model OrderEvent {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  type        String
  body        String?  @db.Text
  meta        Json?
  authorEmail String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
}

model ShippingZone {
  id                    String @id @default(cuid())
  tenantId              String
  name                  String
  countries             String[]
  flatRateAmount        Int    @default(0)
  freeShippingThreshold Int?
  perKgAmount           Int?
  currency              String @default("USD") @db.Char(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model StripeWebhookEvent {
  id        String   @id
  type      String
  processed Boolean  @default(false)
  error     String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([processed, createdAt])
}

model GopayWebhookEvent {
  id        String   @id
  type      String
  processed Boolean  @default(false)
  error     String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([processed, createdAt])
}

model FinikWebhookEvent {
  id        String   @id
  type      String
  processed Boolean  @default(false)
  error     String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([processed, createdAt])
}

model AbandonedCart {
  id             String    @id @default(cuid())
  tenantId       String
  sessionKey     String
  email          String?
  items          Json
  subtotalAmount Int       @default(0)
  currency       String    @default("USD") @db.Char(3)
  remindedAt1h   DateTime? @db.Timestamptz(6)
  remindedAt24h  DateTime? @db.Timestamptz(6)
  convertedAt    DateTime? @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sessionKey])
  @@index([tenantId, convertedAt])
  @@index([tenantId, updatedAt])
}

/** Real-time storefront presence for merchant Live View. */
model StoreLiveVisitor {
  id          String   @id @default(cuid())
  tenantId    String
  sessionId   String
  country     String?  @db.Char(2)
  path        String?
  stage       String   @default("browse") // browse | cart | checkout | purchase
  maxStage    String   @default("browse")
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?
  lastSeenAt  DateTime @default(now()) @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sessionId])
  @@index([tenantId, lastSeenAt])
  @@index([tenantId, createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  userEmail  String
  action     String
  entityType String?
  entityId   String?
  summary    String
  meta       Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model EmailCampaign {
  id              String               @id @default(cuid())
  tenantId        String
  name            String?
  segment         EmailCampaignSegment
  subject         String
  subjectB        String?
  abTestPercent   Int                  @default(0)
  bodyHtml        String               @db.Text
  plainText       String?              @db.Text
  templateId      String?
  discountCode    String?
  utmCampaign     String?
  collectionSlug  String?
  productId       String?
  status          EmailCampaignStatus  @default(DRAFT)
  scheduledAt     DateTime?            @db.Timestamptz(6)
  recipientCount  Int                  @default(0)
  sentCount       Int                  @default(0)
  failedCount     Int                  @default(0)
  openCount       Int                  @default(0)
  clickCount      Int                  @default(0)
  openCountA      Int                  @default(0)
  openCountB      Int                  @default(0)
  createdByEmail  String?
  sentAt          DateTime?            @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, status, scheduledAt])
}

model EmailSubscriber {
  id              String    @id @default(cuid())
  tenantId        String
  email           String
  name            String?
  source          String    @default("import")
  marketingOptOut Boolean   @default(false)
  confirmedAt     DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

model EmailAutomation {
  id         String               @id @default(cuid())
  tenantId   String
  type       EmailAutomationType
  name       String?
  segment    EmailCampaignSegment?
  enabled    Boolean              @default(false)
  subject    String
  bodyHtml   String               @db.Text
  delayHours Int                  @default(0)
  lastRunAt  DateTime?            @db.Timestamptz(6)
  createdAt  DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime             @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type])
  @@index([tenantId, enabled])
}

model GiftCard {
  id              String    @id @default(cuid())
  tenantId        String
  code            String
  initialBalance  Int
  balanceCents    Int
  currency        String    @default("USD") @db.Char(3)
  active          Boolean   @default(true)
  expiresAt       DateTime? @db.Timestamptz(6)
  recipientEmail  String?
  note            String?   @db.Text
  purchasedOrderId String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model ProductBundle {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  slug        String
  description String?  @db.Text
  priceAmount Int
  currency    String   @default("USD") @db.Char(3)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  ProductBundleItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, active])
}

model ProductBundleItem {
  id        String @id @default(cuid())
  bundleId  String
  productId String
  quantity  Int    @default(1)

  bundle  ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isDefault Boolean  @default(false)
  address1  String?
  address2  String?
  city      String?
  postal    String?
  country   String?  @db.Char(2)
  phone     String?
  pickupEnabled      Boolean @default(false)
  pickupInstructions String? @db.Text
  pickupHours        Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stock  WarehouseStock[]
  movements     InventoryMovement[]
  transfersOut  InventoryTransfer[] @relation("TransferFrom")
  transfersIn   InventoryTransfer[] @relation("TransferTo")
  purchaseOrders PurchaseOrder[]
  pickupOrders   Order[] @relation("OrderPickupWarehouse")
  fulfillmentShipments FulfillmentShipment[]

  @@index([tenantId])
}

model WarehouseStock {
  id          String  @id @default(cuid())
  warehouseId String
  productId   String
  variantId   String?
  quantity    Int     @default(0)
  reservedQty Int     @default(0)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, variantId])
  @@index([warehouseId])
  @@index([productId])
}

model InventoryMovement {
  id            String   @id @default(cuid())
  tenantId      String
  warehouseId   String?
  productId     String
  variantId     String?
  type          String
  quantityDelta Int
  referenceType String?
  referenceId   String?
  note          String?  @db.Text
  authorEmail   String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([productId])
  @@index([warehouseId])
}

model InventoryTransfer {
  id              String                  @id @default(cuid())
  tenantId        String
  fromWarehouseId String
  toWarehouseId   String
  status          InventoryTransferStatus @default(DRAFT)
  note            String?                 @db.Text
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  receivedAt      DateTime?               @db.Timestamptz(6)

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse               @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse               @relation("TransferTo", fields: [toWarehouseId], references: [id])
  lines         InventoryTransferLine[]

  @@index([tenantId, status])
}

model InventoryTransferLine {
  id         String @id @default(cuid())
  transferId String
  productId  String
  variantId  String?
  quantity   Int

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([transferId])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  tenantId     String
  warehouseId  String
  supplierName String
  status       PurchaseOrderStatus @default(DRAFT)
  note         String?             @db.Text
  expectedAt   DateTime?           @db.Timestamptz(6)
  receivedAt   DateTime?           @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  lines     PurchaseOrderLine[]

  @@index([tenantId, status])
}

model PurchaseOrderLine {
  id                String @id @default(cuid())
  purchaseOrderId   String
  productId         String
  variantId         String?
  quantityOrdered   Int
  quantityReceived  Int    @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model MerchantWebhook {
  id        String   @id @default(cuid())
  tenantId  String
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant     Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries MerchantWebhookDelivery[]

  @@index([tenantId, active])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

/// One outbound webhook attempt log. Retried by cron with exponential backoff.
model MerchantWebhookDelivery {
  id             String                @id @default(cuid())
  tenantId       String
  webhookId      String
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime?             @db.Timestamptz(6)
  lastStatusCode Int?
  lastError      String?
  deliveredAt    DateTime?             @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhook MerchantWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([webhookId, createdAt])
  @@index([status, nextAttemptAt])
}

model MerchantApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  keyPrefix  String
  keyHash    String
  lastUsedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model MetaobjectDefinition {
  id        String   @id @default(cuid())
  tenantId  String
  type      String
  name      String
  fieldDefs Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metaobjects Metaobject[]

  @@unique([tenantId, type])
  @@index([tenantId])
}

model Metaobject {
  id           String   @id @default(cuid())
  tenantId     String
  definitionId String
  handle       String
  fields       Json
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  definition MetaobjectDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, definitionId, handle])
  @@index([tenantId])
}

model Metafield {
  id        String            @id @default(cuid())
  tenantId  String
  ownerType MetafieldOwnerType
  ownerId   String
  namespace String            @default("custom")
  key       String
  type      String            @default("single_line_text")
  value     String            @db.Text
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, ownerType, ownerId, namespace, key])
  @@index([tenantId, ownerType, ownerId])
}

model ReturnRequest {
  id                 String       @id @default(cuid())
  tenantId           String
  orderId            String
  customerId         String?
  status             ReturnStatus @default(REQUESTED)
  rmaCode            String
  reason             String?
  note               String?      @db.Text
  isExchange         Boolean      @default(false)
  exchangeProductId  String?
  exchangeVariantId  String?
  labelUrl           String?
  trackingNumber     String?
  refundAmountCents  Int?
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    ReturnLineItem[]

  @@unique([tenantId, rmaCode])
  @@index([tenantId, status])
  @@index([orderId])
}

model ReturnLineItem {
  id              String @id @default(cuid())
  returnId        String
  orderLineItemId String
  quantity        Int
  reason          String?

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderLineItem OrderLineItem @relation(fields: [orderLineItemId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

model B2bPriceList {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  currency  String   @db.Char(3)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     B2bPriceListItem[]
  companies B2bCompany[]

  @@index([tenantId])
}

model B2bPriceListItem {
  id          String  @id @default(cuid())
  priceListId String
  productId   String
  variantId   String?
  priceAmount Int

  priceList B2bPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId, variantId])
  @@index([priceListId])
}

model B2bCompany {
  id               String           @id @default(cuid())
  tenantId         String
  name             String
  status           B2bCompanyStatus @default(PENDING)
  paymentTermsDays Int?
  depositPercent   Int?
  note             String?          @db.Text
  priceListId      String?
  catalogProductIds String[]        @default([])
  /// Named catalogs: [{ id, name, productIds }]
  catalogs         Json?
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList B2bPriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  buyers    B2bBuyer[]
  customers Customer[]
  orders    Order[]
  quotes    B2bQuote[]

  @@index([tenantId, status])
}

model B2bBuyer {
  id         String       @id @default(cuid())
  companyId  String
  customerId String       @unique
  email      String
  role       B2bBuyerRole @default(BUYER)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)

  company  B2bCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model ProductSubscription {
  id                   String                     @id @default(cuid())
  tenantId             String
  customerId           String
  productId            String
  orderId              String?
  stripeSubscriptionId String                     @unique
  stripeCustomerId     String?
  status               ProductSubscriptionStatus  @default(INCOMPLETE)
  interval             String
  currentPeriodEnd     DateTime?                  @db.Timestamptz(6)
  dunningStep          Int                        @default(0)
  lastDunningAt        DateTime?                  @db.Timestamptz(6)
  createdAt            DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([customerId])
}

model FulfillmentShipment {
  id             String   @id @default(cuid())
  tenantId       String
  orderId        String
  warehouseId    String?
  status         String   @default("OPEN")
  trackingNumber String?
  labelUrl       String?
  shippedAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  lines     FulfillmentLine[]

  @@index([tenantId, orderId])
  @@index([warehouseId])
}

model FulfillmentLine {
  id              String @id @default(cuid())
  shipmentId      String
  orderLineItemId String
  quantity        Int

  shipment      FulfillmentShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderLineItem OrderLineItem       @relation(fields: [orderLineItemId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model B2bQuote {
  id            String   @id @default(cuid())
  tenantId      String
  companyId     String
  title         String
  status        String   @default("DRAFT")
  currency      String   @db.Char(3)
  subtotalCents Int      @default(0)
  note          String?  @db.Text
  validUntil    DateTime? @db.Timestamptz(6)
  lines         Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company B2bCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId])
}

model DigitalEntitlement {
  id             String    @id @default(cuid())
  tenantId       String
  customerId     String
  productId      String
  subscriptionId String?
  orderId        String?
  active         Boolean   @default(true)
  accessToken    String    @unique
  expiresAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([productId])
  @@index([subscriptionId])
}

enum BackgroundJobStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  DEAD
}

/// Durable outbox for emails and other work that must survive Vercel freezes.
model BackgroundJob {
  id          String              @id @default(cuid())
  type        String
  payload     Json
  status      BackgroundJobStatus @default(PENDING)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(8)
  runAt       DateTime            @default(now()) @db.Timestamptz(6)
  lockedAt    DateTime?           @db.Timestamptz(6)
  lastError   String?
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  completedAt DateTime?           @db.Timestamptz(6)

  @@index([status, runAt])
  @@index([type, createdAt])
}

/// Why a merchant cancelled (or tried to) their platform plan — churn insights + save offers.
model PlanCancelFeedback {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String?
  planSlug      String?
  reason        String
  details       String?
  acceptedOffer Boolean  @default(false)
  offerCode     String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// Staff-only notes on a customer (not visible on storefront).
model CustomerNote {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String
  body        String   @db.Text
  authorEmail String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([customerId, createdAt])
}

/// Snapshot of product fields for history / rollback.
model ProductRevision {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  snapshot    Json
  summary     String?
  authorEmail String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, createdAt])
}

/// Named saved views for orders / products list query strings.
model SavedFilter {
  id          String   @id @default(cuid())
  tenantId    String
  scope       String
  name        String
  query       Json
  authorEmail String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, scope])
}
