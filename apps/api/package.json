{
  "name": "@ugclab/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "start": "tsx src/dev-server.ts",
    "build": "npm run build -w @ugclab/i18n && npm run build -w @ugclab/tenant && tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/lib/finik/finik.test.ts",
    "test:finik": "tsx --test src/lib/finik/finik.test.ts",
    "deploy": "cd ../.. && vercel --prod --yes"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@mancho.devs/authorizer": "^2.12.8",
    "@ugclab/database": "*",
    "@ugclab/i18n": "*",
    "@ugclab/tenant": "*",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "hono": "^4.7.10",
    "jose": "^6.0.11",
    "postgres": "^3.4.9",
    "stripe": "^17.7.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "@ugclab/config": "*",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
