{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "framework": null,
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "node scripts/vercel-build.mjs",
  "crons": [{ "path": "/api/cron", "schedule": "0 3 * * *" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "../../node_modules/.prisma/**"
    },
    "api/cron.ts": {
      "maxDuration": 60,
      "includeFiles": "../../node_modules/.prisma/**"
    },
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/health-ready.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/api/health/ping", "destination": "/api/health-ping" },
    { "source": "/api/health/ready", "destination": "/api/health-ready" },
    { "source": "/api/cron", "destination": "/api/cron" },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "tenant" }],
      "destination": "/storefront.html"
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "query", "key": "tenant" }],
      "destination": "/storefront.html"
    },
    { "source": "/(.*)", "destination": "/api" }
  ]
}
